{
  "name": "school-erp-backend",
  "version": "1.0.0",
  "description": "School ERP Backend - Scalable REST API built with Node.js, Express, MongoDB",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node dist/app.js",
    "build": "node esbuild.config.js",
    "build:dev": "node esbuild.config.js --dev",
    "obfuscate": "node obfuscate.config.js",
    "build:obfuscated": "npm run build && npm run obfuscate",
    "start:obfuscated": "node dist-obfuscated/app.js",
    "seed": "node src/seed/seed.js",
    "migrate": "node src/seed/migrate.js"
  },
  "keywords": [
    "school",
    "erp",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "javascript-obfuscator": "^5.4.3",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
