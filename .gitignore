# Secrets — never commit environment or credential files (any directory)
.env
.env.*
*.env
!.env.example
!**/.env.example
credentials.md

session

# TypeScript incremental build cache — regenerated by every build
*.tsbuildinfo

# Runtime user uploads — served from disk, never source
backend/uploads/*
!backend/uploads/.gitkeep

# Working notes kept out of version control on request.
