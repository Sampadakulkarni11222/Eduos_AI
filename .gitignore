**/node_modules/
**/.next/
**/dist/
**/build/

# Secrets — never commit environment or credential files (any directory)
.env
.env.*
*.env
!.env.example
!**/.env.example
credentials.md

# Anchored to the repo root: a bare `session` also matched
# frontend/src/app/api/session/, so the refresh-token routes were never committed.
/session

# Personal Claude Code permission overrides (per-developer, not team-wide)
.claude/settings.local.json

# TypeScript incremental build cache — regenerated by every build
*.tsbuildinfo

# Runtime user uploads — served from disk, never source
backend/uploads/*
!backend/uploads/.gitkeep

# Working notes kept out of version control on request.
# Security notes especially: a list of what is weak does not belong in a repo.
SECURITY_ACTIONS.md
issues_sheet.md

# Runtime logs, wherever a process happens to write them.
logs/
*.log
