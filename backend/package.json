{
  "name": "school-erp-backend",
  "version": "1.0.0",
  "description": "School ERP Backend - Scalable REST API built with Node.js, Express, MongoDB",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node dist/app.js",
    "build": "node esbuild.config.js",
    "build:dev": "node esbuild.config.js --dev",
    "obfuscate": "node obfuscate.config.js",
    "build:obfuscated": "npm run build && npm run obfuscate",
    "start:obfuscated": "node dist-obfuscated/app.js",
    "seed": "node src/seed/seed.js",
    "seed:school": "node src/seed/seed_school_data.js",
    "superadmin:create": "node scripts/create-super-admin.js",
    "owner:drop": "node scripts/drop-owner-role.js",
    "schools:migrate": "node scripts/migrate-to-schools.js",
    "schools:rename": "node scripts/rename-school-slug.js",
    "migrate": "node src/seed/migrate.js",
    "migrate:atlas": "node scripts/migrate_to_atlas.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:local": "node scripts/run-local.js",
    "dev:local:seed": "node scripts/run-local.js --seed",
    "seed:electives": "node scripts/seed-electives-demo.js",
    "electives:plan": "node scripts/add-electives.js",
    "electives:apply": "node scripts/add-electives.js --apply",
    "registrations:plan": "node scripts/seed-registrations.js",
    "registrations:apply": "node scripts/seed-registrations.js --apply"
  },
  "keywords": [
    "school",
    "erp",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/generative-ai": "^0.21.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.24.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.15.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.4.3",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
