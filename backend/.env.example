# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=localhost

# ─── MongoDB ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/school_erp

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── CORS ─────────────────────────────────────────────────
# Must name your frontend origin. Production refuses to boot on '*'.
CORS_ORIGIN=http://localhost:3000

# ─── Swagger ──────────────────────────────────────────────
# true  → Swagger UI available at /api-docs
# false → Swagger UI and /api-docs.json are not mounted
# Default: true in development, false in production (when NODE_ENV=production)
SWAGGER_ENABLED=true

# ─── One-time sign-in codes (OTP) ─────────────────────────
# console → nothing is sent; the code is logged and returned to the client as
#           `devOtp` ONLY when NODE_ENV is development or test. Anywhere else
#           OTP sign-in answers 503 and password/Google sign-in still work.
# resend  → email via Resend  (RESEND_API_KEY, EMAIL_FROM)
# twilio  → SMS via Twilio    (TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER)
# In production a provider named here but missing its settings refuses to boot.
# ALLOW_DEV_OTP_IN_PRODUCTION no longer exists as a switch: production never
# returns a code, and the variable only produces a boot warning if still set.
SMS_PROVIDER=console
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Session refresh proxy ────────────────────────────────
# Shared with the frontend server's FRONTEND_PROXY_SECRET. Lets its refresh
# proxy (which limits failed refreshes per real client) skip this server's
# per-address failed-refresh limit (RATE_LIMIT_REFRESH_FAIL_MAX, default 100
# per window). Optional.
FRONTEND_PROXY_SECRET=
# Optional dedicated key for signed /uploads links (defaults to JWT_SECRET).
FILE_URL_SECRET=

# ─── Auth (JWT + OTP + sessions) ──────────────────────────
JWT_SECRET=change-this-secret-in-production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
BCRYPT_SALT_ROUNDS=10

# true  → accounts with multiple profiles get a pre-session and must call
#         POST /auth/profile/select before doing anything else
# false → always auto-select the most recently created profile, skipping
#         the selection step entirely (use when nobody has >1 role)
MULTI_PROFILE_ENABLED=true

# ─── Super Admin (platform tier) ───────────────────────────
# The Super Admin manages schools and their School Admin accounts. It is the
# only role holding schools.read / schools.manage; no school-level role can
# reach that surface.
#
# Put the Google address of your platform administrator here and it is
# provisioned as SUPER_ADMIN the first time it signs in through "Continue with
# Google" — Google has already verified the address belongs to them, so no
# password is seeded anywhere. Comma-separate for more than one; SUPER_ADMIN_EMAIL
# (singular) is read too.
#
# Clearing this does NOT revoke anyone: it only stops new provisioning. Remove
# the profile to take access away.
SUPER_ADMIN_EMAILS=

# Google Sign-In. With this set, POST /auth/google verifies the ID token's
# signature, issuer and audience before trusting the email on it.
GOOGLE_CLIENT_ID=

# ─── Sensitive data encryption (medical records) ──────────
MEDICAL_ENCRYPTION_KEY=change-this-medical-key-in-production

# ─── WhatsApp Business (Meta) ──────────────────────────────
# With none of WA_* set, the bot runs in simulation: it logs outbound replies
# instead of sending them, and webhook signature checks pass so the flow can be
# exercised without credentials.
#
# WA_APP_SECRET is what makes the webhook reject forged payloads. Once it is
# set, EVERY inbound request must carry a valid x-hub-signature-256 — including
# your own test scripts.
WHATSAPP_VERIFY_TOKEN=change-this-verify-token
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# App Secret from the Meta app dashboard. Authenticates inbound webhooks.
# Required once WA_PHONE_NUMBER_ID and WA_ACCESS_TOKEN are set: without it the
# webhook cannot tell Meta from anyone else who has guessed the URL, so
# production refuses to start and webhooks are refused outside development.
WA_APP_SECRET=
# ── Webhook registration (setup only, never read at runtime) ──
# Credentials alone do not make messages arrive. Meta also needs the callback
# URL and a subscription to the `messages` field -- and a URL that verifies but
# is not subscribed stays silent forever, which is indistinguishable from a
# broken bot. `npm run whatsapp:webhook` does both over the API using these.
#
# Neither ID is a secret: the App ID is public, the WABA ID is visible to
# everyone in the Business account.
#
# App ID    — developers.facebook.com → your app → dashboard header
# WABA ID   — business.facebook.com → WhatsApp Manager → Account tools
WA_APP_ID=
WA_WABA_ID=
# Public HTTPS origin Meta delivers to, no trailing slash and no path -- the
# script appends /api/v1/whatsapp/webhook itself. A tunnel (cloudflared, ngrok)
# in development; your deployed API origin in production.
WA_CALLBACK_ORIGIN=
# ── Family WhatsApp hand-off ("Chat on WhatsApp" in Ask Agent) ──
# The number families message, in international format. Digits, +, spaces and
# dashes are all accepted; anything unparseable hides the button rather than
# producing a dead wa.me link. NOT the same as WA_PHONE_NUMBER_ID above.
SCHOOL_WHATSAPP_NUMBER=
# Set false to hide the button without unsetting the number. Defaults to true.
WHATSAPP_ENABLED=true
# ── WhatsApp conversation memory ──
# Idle gap after which the next message starts a fresh session. Purely about
# relevance: who the sender is, and what they may see, is re-resolved on every
# turn either way.
WHATSAPP_SESSION_IDLE_MINUTES=120
# Turns of transcript given to the model so a follow-up ("what about last
# month?") can be resolved, and a write answered over several turns is
# recovered. Same as the website (10).
WHATSAPP_HISTORY_TURNS=10


# ─── AI provider ───────────────────────────────────────────
# rules   → no model. Deterministic answers only (default, and a valid
#           production choice: the agent, fees, attendance and results all work).
# gemini  → requires GEMINI_API_KEY
# anthropic → requires ANTHROPIC_API_KEY
# openrouter → requires OPENROUTER_API_KEY
#
# Only these four are implemented. Setting anything else disables generation.
#
# Fallback: with AI_PROVIDER=gemini or anthropic, setting OPENROUTER_API_KEY
# makes OpenRouter answer whenever that provider errors, times out, is
# rate-limited or has its circuit open. AI_PROVIDER=rules never uses a model.
#
# What a model actually adds: tutor explanations, OCR of paper attendance
# registers, and a fallback for phrasings the rule parser misses. Everything
# else is deterministic and needs no key.
AI_PROVIDER=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENROUTER_API_KEY=
# Any id from https://openrouter.ai/models. openrouter/auto lets OpenRouter pick.
OPENROUTER_MODEL=openrouter/auto
# Comma-separated; OpenRouter tries these in order if OPENROUTER_MODEL fails.
OPENROUTER_FALLBACK_MODELS=
# Caps max_tokens per call. OpenRouter reserves credit for the whole cap up
# front, so a high value on a small balance is refused with 402.
OPENROUTER_MAX_TOKENS=4096
# Optional attribution headers (HTTP-Referer / X-Title).
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=EduOS

# ─── AI credit metering (students & parents only; staff are never metered) ──
# 0 is honoured and means "no free tier — credits must be bought".
AI_FREE_MONTHLY_CREDITS=50

# ─── AI assistant rate limiting ────────────────────────────
# The agent limits are enforced per ACTOR inside the core, so they hold on
# WhatsApp too (where every request shares Meta's IP). Counters are in process
# memory — move them to Redis before running more than one instance.
RATE_LIMIT_AI_MAX=30
AGENT_RATE_LIMIT_PER_MIN=20
AGENT_INJECTION_STRIKES=3
AGENT_INJECTION_BLOCK_MS=60000

# ─── Seats ─────────────────────────────────────────────────
# DEFAULT list price of one extra seat, in paise — what a school is charged when
# the Super Admin has not priced it specifically. Per-school rates are set in the
# console (Super Admin -> Per-Seat Pricing) and override this; a school with no
# price of its own falls back here. The server prices every extra-seat request
# from the rate it resolves and ignores any amount a client sends; volume
# discounts live in src/modules/seats/seat.pricing.js. Extra seats are paid for
# through the same gateway as fees, and a Super Admin still has to approve a
# paid request before the seats can be used.
SEAT_UNIT_PRICE_PAISE=50000

# ─── School domains ────────────────────────────────────────
# Super Admin -> Domain Management gives each school either a platform subdomain
# or its own custom domain. Nothing is activated because a hostname was typed:
# the server checks real DNS (and a real TLS handshake) before a domain can go
# live. See docs/DOMAINS.md for the records a school has to create.
#
# The domain this deployment owns; subdomains are issued under it. Leave empty
# to disable subdomains. Needs a wildcard DNS record (*.<domain>) and a wildcard
# certificate at the host before any subdomain will verify.
PLATFORM_DOMAIN=
# Where a school's custom domain must CNAME to (e.g. school-erp-frontend.onrender.com).
DOMAIN_CNAME_TARGET=
# Per-query timeout for DNS lookups and TLS handshakes during verification.
DOMAIN_CHECK_TIMEOUT_MS=5000

# ─── Razorpay (PAYMENT_PROVIDER=razorpay) ──────────────────
# Key id/secret: Razorpay Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#
# The webhook secret is a SEPARATE value you choose yourself when creating the
# webhook at Dashboard → Settings → Webhooks. It is not an API key and cannot be
# read back from Razorpay afterwards, so keep it here and in the dashboard in
# step. Whatever you type into that form must equal this value exactly.
#
# It is what proves an incoming "payment captured" is really from Razorpay. The
# webhook is the authoritative path: the browser callback settles a payment when
# checkout completes normally, but only the webhook settles one where the payer
# closed the tab. If this does not match, every delivery is rejected 401 and
# those payments never land.
#
# Subscribe the webhook to: payment.captured
# URL: https://<your-public-host>/api/v1/fees/webhooks/razorpay
# Locally, expose it with:  ngrok http 5000
RAZORPAY_WEBHOOK_SECRET=
